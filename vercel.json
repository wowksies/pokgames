{
  "rewrites": [
    {
      "source": "/cdn/(.*)",
      "destination": "https://785b74a4-e22d-4d31-90ef-92b80679f7e6.gdn.poki.com/34a362fa-4b92-4956-b93f-e02ef0fb6a91/StreamingAssets/$1"
    }
  ],
  "headers": [
    {
      "source": "/tankstars/Build/(.*)\\.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
