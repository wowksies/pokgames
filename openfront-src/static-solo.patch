diff --git a/static-solo/renderIndex.mjs b/static-solo/renderIndex.mjs
new file mode 100644
index 0000000..02575e7
--- /dev/null
+++ b/static-solo/renderIndex.mjs
@@ -0,0 +1,36 @@
+// Render the EJS index.html that vite emits into a plain static page, filling
+// in the values a game server would normally inject at request time.
+//
+//   node static-solo/renderIndex.mjs <staticDir> <basePath>
+import ejs from "ejs";
+import fs from "fs";
+import path from "path";
+
+const [, , staticDir, base] = process.argv;
+const manifest = JSON.parse(
+  fs.readFileSync(path.join(staticDir, "asset-manifest.json"), "utf8"),
+);
+const url = (p) => (manifest[p] ? base + manifest[p] : `${base}/${p}`);
+const TRANSPARENT_PIXEL =
+  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
+const indexPath = path.join(staticDir, "index.html");
+
+const html = ejs.render(fs.readFileSync(indexPath, "utf8"), {
+  gitCommit: JSON.stringify(process.env.GIT_COMMIT ?? "static-solo"),
+  assetManifest: JSON.stringify(manifest),
+  cdnBase: JSON.stringify(base),
+  cdnBaseRaw: base,
+  gameEnv: JSON.stringify("prod"),
+  turnstileSiteKey: JSON.stringify("1x00000000000000000000AA"),
+  // Points the account API at an origin the page's fetch shim answers
+  // locally, so every API call fails fast into the offline fallbacks.
+  jwtAudience: JSON.stringify("offline.invalid"),
+  manifestHref: url("manifest.json"),
+  faviconHref: url("images/Favicon.svg"),
+  gameplayScreenshotUrl: url("images/GameplayScreenshot.png"),
+  backgroundImageUrl: url("images/background.webp"),
+  // No big watermark logo behind the menu.
+  desktopLogoImageUrl: TRANSPARENT_PIXEL,
+  mobileLogoImageUrl: TRANSPARENT_PIXEL,
+});
+fs.writeFileSync(indexPath, html);
